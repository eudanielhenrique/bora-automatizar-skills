#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$(dirname "$SCRIPT_DIR")"

echo ""
echo "  bora-automatizar-skills"
echo "  ------------------------"
echo ""

for skill in ba-firestore-backup ba-firestore-restore ba-designer-system ba-proposta-comercial ba-oferta-produtizada ba-monitoramento-equipe ba-integracoes ba-controle-operacional; do
    target="$SKILLS_DIR/$skill"
    if [ -L "$target" ] || [ -e "$target" ]; then
        rm -rf "$target"
    fi
    ln -s "$SCRIPT_DIR/$skill" "$target"
    echo "  /$skill instalado"
done

echo ""
echo "  Skills instaladas:"
echo ""
echo "    /ba-firestore-backup     Exportar collections do Firestore para JSON"
echo "    /ba-firestore-restore    Restaurar dados do Firestore a partir de JSON"
echo "    /ba-designer-system      Aplicar o design system do Bora Automatizar"
echo "    /ba-proposta-comercial   Gerar proposta comercial em HTML no padrão Bora Automatizar"
echo "    /ba-oferta-produtizada   Gerar landing de oferta produtizada (Projeto Éter)"
echo "    /ba-monitoramento-equipe Boletim diário/semanal da equipe de WhatsApp"
echo "    /ba-integracoes          Conectar sistemas existentes do cliente (Sheets, CRM, Stripe, etc.)"
echo "    /ba-controle-operacional Controle operacional via CSV pro cliente sem sistema"
echo ""
echo "  Pré-requisito:"
echo "    - serviceAccountKey.json na raiz do projeto"
echo ""
echo "  O pacote firestore-export-import é instalado automaticamente ao invocar cada skill."
echo ""
echo "  Pronto."
echo ""
